// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) - used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection - used only for `prisma db push` / `prisma migrate`.
  directUrl = env("DIRECT_URL")
}

model Supplier {
  id        String    @id @default(cuid())
  name      String    @unique
  email     String?
  phone     String?
  address   String?
  gstin     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]
  invoices  Invoice[]
}

model Product {
  id                String    @id @default(cuid())
  // Optional: some purchased parts arrive without a manufacturer/vendor part
  // number. Nullable + @unique is safe in Postgres — the unique index allows
  // any number of NULLs, so multiple no-part-number products can coexist.
  partNo            String?   @unique
  description       String
  category          String?
  supplierId        String?
  currentStock      Float     @default(0)
  totalPurchased    Float     @default(0)
  totalUsed         Float     @default(0)
  unitPrice         Float     @default(0)
  lastPurchaseDate  DateTime?
  lowStockThreshold Float     @default(5)
  status            String    @default("ACTIVE")
  // Physical stock/lifecycle state — distinct from `status` above (which is
  // catalog ACTIVE/DISCONTINUED). Options in src/lib/componentStatus.ts.
  componentStatus   String    @default("AVAILABLE_STOCK")
  // Free text: which team/person currently holds this if borrowed/assigned.
  assignedTo        String?
  // Whether a borrowed/loaned-out unit is expected back.
  refundable        Boolean   @default(false)
  // How much of currentStock is earmarked for sale (e.g. via Shopify)
  // rather than available for internal/project use. Available-for-use is
  // computed as currentStock - ecommerceAllocated, not stored separately,
  // so it never drifts out of sync.
  ecommerceAllocated Float    @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  invoiceItems      InvoiceItem[]
  projectComponents ProjectComponent[]
  purchaseHistory   PurchaseHistory[]
  stockMovements    StockMovement[]
}

model Invoice {
  id           String    @id @default(cuid())
  invoiceNo    String    @unique
  poNumber     String?
  supplierId   String?
  invoiceDate  DateTime?
  baseAmount   Float     @default(0)
  gstAmount    Float     @default(0)
  cgst         Float     @default(0)
  sgst         Float     @default(0)
  igst         Float     @default(0)
  otherTax     Float     @default(0)
  totalAmount  Float     @default(0)
  receivedDate DateTime?
  status       String    @default("NOT_RECEIVED")
  filePath     String?
  fileType     String?
  fileName     String?
  notes        String?
  // Which of the company's purchasing accounts this invoice was paid from
  // (they use 2-3). Free text rather than a hard enum/table — small enough
  // list that a datalist autocomplete on the form is enough, no separate
  // accounts management screen needed.
  accountNumber String?
  accountName   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  supplier          Supplier?         @relation(fields: [supplierId], references: [id])
  items             InvoiceItem[]
  purchaseHistory   PurchaseHistory[]
  projectComponents ProjectComponent[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  partNo      String?
  description String
  quantity    Float
  unitPrice   Float    @default(0)
  baseAmount  Float    @default(0)
  gstAmount   Float    @default(0)
  totalAmount Float    @default(0)
  // MATCHED: found an existing product by exact part number.
  // AUTO_CREATED: no match was found, so a brand new product was created
  // automatically — flagged for admin review, since this could be a
  // genuinely new part OR a duplicate caused by a misspelling/missing
  // part number.
  // CONFIRMED_NEW: admin reviewed an AUTO_CREATED item and confirmed it's
  // really a new product — flag cleared, no data changes.
  matchStatus String   @default("MATCHED")
  createdAt   DateTime @default(now())

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("ACTIVE")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Components used directly on the project (no sub-part), plus each
  // sub-part below has its own component list.
  components ProjectComponent[]
  subTasks   ProjectSubTask[]
}

// A part/sub-assembly of a project (e.g. an "Articulated Arm" project might
// have sub-tasks "Base", "Joint 1", "Gripper"), each of which consumes its
// own set of products. One level deep only — not recursive/nested
// sub-sub-tasks, which would add real complexity for a benefit that doesn't
// fit an inventory tool.
model ProjectSubTask {
  id        String   @id @default(cuid())
  projectId String
  name      String
  status    String   @default("PENDING") // PENDING | IN_PROGRESS | DONE
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  components ProjectComponent[]
}

model ProjectComponent {
  id           String   @id @default(cuid())
  projectId    String
  // Optional: when set, this usage belongs to a specific sub-part of the
  // project rather than the project as a whole.
  subTaskId    String?
  productId    String
  invoiceId    String?
  quantityUsed Float
  dateUsed     DateTime @default(now())
  notes        String?
  createdAt    DateTime @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subTask ProjectSubTask? @relation(fields: [subTaskId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id])
  // If the source invoice is later deleted, keep this usage record but drop
  // the dangling reference instead of blocking the invoice delete outright
  // (invoiceId is optional, so this is safe).
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

model PurchaseHistory {
  id        String   @id @default(cuid())
  productId String
  invoiceId String
  quantity  Float
  unitPrice Float
  date      DateTime
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  type          String
  quantity      Float
  referenceId   String?
  referenceType String?
  notes         String?
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model AppSettings {
  id                String   @id @default("settings")
  geminiApiKey      String?
  lowStockThreshold Float    @default(5)
  currency          String   @default("INR")
  updatedAt         DateTime @updatedAt
}

// Company-owned tools/equipment (multimeters, drills, etc.) — distinct from
// Product, which is consumable/resellable component stock. Assets aren't
// purchased-and-consumed the same way: they're tracked as individual owned
// items with a status and (optionally) who's holding them.
model Asset {
  id            String    @id @default(cuid())
  name          String
  category      String?
  serialNumber  String?   @unique
  status        String    @default("AVAILABLE_STOCK") // see src/lib/componentStatus.ts
  assignedTo    String?
  refundable    Boolean   @default(false)
  purchaseDate  DateTime?
  purchasePrice Float?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
